APP_NAME=clinical-rag
DEBUG=true

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=clinical_documents

# Embedding Provider Configuration
# "local" for in-process BGE-M3 (AWS EC2 / GPU / CPU), or "remote" for Colab HTTP service
EMBEDDING_PROVIDER_TYPE=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# Docling PDF Parsing Configuration
# "local" for in-process Docling layout parsing, or "remote" for Colab HTTP service
DOCLING_PROVIDER_TYPE=local
DOCLING_DO_OCR=false

# Storage Settings
ASSETS_DIR=src/assets

# Retrieval & Search Settings
DENSE_TOP_K=20
SPARSE_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=10
RRF_K=60

# Reranker Settings (Disabled)
RERANKER_ENABLED=false
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_TIMEOUT=30

# Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
MIN_SIMILARITY_SCORE_THRESHOLD=80.0
